__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# raw/processed data is fetched by scripts/download_data.py, not committed
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet

# player snapshots fetched by scripts/download_player_data.py ARE committed
# on purpose (unlike data/raw/ above). The data refresh (src/pl_predictor/
# refresh.py, the site's "Mettre à jour" button) commits and pushes them, so
# two successive snapshots can be compared (which club a transferred player
# now plays for, see mark_current_club in player_goals.py) and any checkout
# can `git pull` fresh squad data instead of re-scraping FBref itself.

# trained artifacts (regenerated by scripts/train_final_model.py)
models_artifacts/
*.pkl

# backtest outputs regenerated by scripts/run_backtest.py are committed on
# purpose (they back the performance table in the README) - only ignore
# regenerated plots here.
reports/*.png

.DS_Store
downloaded_files/

# Windows shortcut created by run_app.bat's setup - bakes in an absolute
# path (and Windows username), so it's regenerated locally rather than
# committed. See README "Lancement rapide (Windows)".
*.lnk
